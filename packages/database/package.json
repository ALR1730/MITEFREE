{
  "name": "@mitefree/database",
  "version": "1.0.0",
  "private": true,
  "description": "PostgreSQL schema and Drizzle ORM persistence for MITEFREE enterprise - ALR COMPANY",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "type-check": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.39.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.0"
  }
}
