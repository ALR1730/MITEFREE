# Environment
NODE_ENV=development
PORT=3000

# Base de Datos (Neon PostgreSQL 16+)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/mitefree?sslmode=require

# Autenticación (Better Auth / JWT)
BETTER_AUTH_SECRET=your_super_secret_key_minimum_32_characters_long
BETTER_AUTH_URL=http://localhost:3000

# Storage (Cloudflare R2 - $0 Egress Fee)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=mitefree-production
CLOUDFLARE_R2_PUBLIC_URL=https://assets.mitefree.com

# Pasarela de Pagos (Stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Mensajería Oficial (Meta WhatsApp Cloud API)
WHATSAPP_CLOUD_API_TOKEN=EAAB...
WHATSAPP_PHONE_NUMBER_ID=109283746501928
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321012345
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mitefree_webhook_secure_verify_token

# Email Transaccional (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM="MITEFREE <notificaciones@mitefree.com>"

# Cache & Queues (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://sample-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...
